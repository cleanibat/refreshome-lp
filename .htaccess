# refreshome.fr — site statique (remplace WordPress). Hostinger / LiteSpeed.
DirectoryIndex index.html
Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.refreshome\.fr$ [NC]
RewriteRule ^(.*)$ https://refreshome.fr/$1 [R=301,L]

# Anciennes URL WordPress
RewriteRule ^(feed|comments/feed|wp-json|wp-sitemap.*\.xml|accueil)/?$ / [R=301,L]
RewriteRule ^wp-sitemap\.xml$ /sitemap.xml [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "\.(py|md|csv|yml)$">
  Require all denied
</FilesMatch>
